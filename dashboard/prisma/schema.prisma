generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  OWNER
  OPERATOR
  APPROVER
  VIEWER
  PROVIDER_ADMIN
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum AgentStatus {
  PROVISIONING
  ACTIVE
  PAUSED
  ERROR
  ARCHIVED
}

enum CustodyType {
  PLATFORM_MANAGED_TESTNET
  KMS
  SELF_CUSTODY
  EXTERNAL_DELEGATED
}

enum SigningMode {
  AUTONOMOUS_MANAGED
  WALLET_CONFIRMATION
  BOUNDED_DELEGATION
}

enum AccountStatus {
  PROVISIONING
  ACTIVE
  LOCKED
  ERROR
}

enum CredentialStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum PolicyStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum OverLimitAction {
  DENY
  REQUIRE_APPROVAL
}

enum MerchantMode {
  ANY
  ALLOWLIST_ONLY
}

enum PaymentStatus {
  CREATED
  QUOTED
  DENIED
  APPROVAL_PENDING
  REJECTED
  EXPIRED
  AUTHORIZED
  SIGNING
  SUBMITTED
  SUBMISSION_UNKNOWN
  SETTLED
  SETTLEMENT_FAILED
  FAILED_BEFORE_SUBMISSION
  CANCELED
}

enum PolicyOutcome {
  ALLOW
  DENY
  REQUIRE_APPROVAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELED
  CONSUMED
}

enum ApprovalDecisionType {
  APPROVE
  REJECT
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  SETTLED
  RELEASED
  EXPIRED
}

enum AttemptStatus {
  STARTED
  SIGNED
  SUBMITTED
  CONFIRMED
  FAILED
  UNKNOWN
}

enum SettlementStatus {
  PENDING
  CONFIRMED
  FAILED
  UNKNOWN
}

enum AssetType {
  NATIVE
  TOKEN
}

enum ResourceCategory {
  MARKET_DATA
  FILE
  AI_INFERENCE
  WEB_RESEARCH
}

enum ResourceStatus {
  DRAFT
  ACTIVE
  PAUSED
  UNAVAILABLE
}

enum ProviderStatus {
  ACTIVE
  PAUSED
  UNAVAILABLE
}

enum ProviderVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ResourceHealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  DOWN
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  APPROVAL_PENDING
  PAYMENT_PENDING
  PAID
  OVERDUE
  VOID
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

enum FulfillmentStatus {
  PENDING
  FULFILLED
  FAILED
}

enum NotificationChannelType {
  WEBHOOK
  EMAIL
  SLACK
}

enum NotificationEndpointStatus {
  ACTIVE
  PAUSED
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  RETRY_SCHEDULED
  DEAD_LETTER
}

enum DeletionRequestStatus {
  REQUESTED
  CANCELED
  PROCESSING
  COMPLETED
}

enum PlanTier {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

enum SupportCaseStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportSeverity {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CardProvider {
  SANDBOX
  STRIPE
}

enum CardholderStatus {
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
}

enum VirtualCardStatus {
  INACTIVE
  ACTIVE
  FROZEN
  CANCELED
}

enum CardAuthorizationStatus {
  PENDING
  APPROVED
  DECLINED
  REVERSED
  CLOSED
}

enum FiatAccountStatus {
  PENDING
  ACTIVE
  RESTRICTED
  CLOSED
}

enum FiatTransferDirection {
  DEPOSIT
  WITHDRAWAL
}

enum FiatTransferStatus {
  PENDING
  PROCESSING
  SUBMISSION_UNKNOWN
  SUCCEEDED
  FAILED
  CANCELED
}

enum ProviderWebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum ChainFamily {
  HEDERA
  EVM
}

enum CrossChainQuoteStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  CANCELED
}

enum CrossChainTransferStatus {
  QUOTED
  AWAITING_SIGNATURE
  SUBMITTED
  BRIDGING
  DESTINATION_CONFIRMED
  FAILED
  REFUNDED
  CANCELED
}

enum AutomationRuleStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AutomationTriggerType {
  MANUAL
  SCHEDULE
  BALANCE_THRESHOLD
  INVOICE_EVENT
  WEBHOOK
}

enum AutomationActionType {
  CONTRACT_CALL
  X402_PAYMENT
  CREATE_INVOICE
}

enum AutomationExecutionStatus {
  PENDING
  AWAITING_APPROVAL
  EXECUTING
  SUBMISSION_UNKNOWN
  SUCCEEDED
  FAILED
  CANCELED
}

enum AutomationDecisionType {
  APPROVE
  REJECT
}

enum FinancialLedgerType {
  CRYPTO_PAYMENT
  VIRTUAL_CARD
  FIAT_TRANSFER
  INVOICE
}

enum IntelligenceRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum FinancialAnomalyStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum RecommendationStatus {
  OPEN
  ACCEPTED
  DISMISSED
  SUPERSEDED
}

model User {
  id                            String                        @id @default(uuid()) @db.Uuid
  email                         String?                       @unique
  displayName                   String
  createdAt                     DateTime                      @default(now()) @db.Timestamptz
  memberships                   Membership[]
  identities                    WalletIdentity[]
  approvalDecisions             ApprovalDecision[]
  cardholderProfiles            CardholderProfile[]
  resourceReviews               ResourceReview[]
  automationDecisions           AutomationExecutionDecision[]
  triggeredAutomationExecutions AutomationExecution[]         @relation("AutomationTriggeredBy")
}

model Organization {
  id                    String                      @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String                      @unique
  status                OrganizationStatus          @default(ACTIVE)
  environmentMode       String                      @default("TESTNET_ONLY")
  killSwitchEnabled     Boolean                     @default(false)
  timezone              String                      @default("UTC")
  createdAt             DateTime                    @default(now()) @db.Timestamptz
  updatedAt             DateTime                    @updatedAt @db.Timestamptz
  memberships           Membership[]
  agents                Agent[]
  policies              Policy[]
  paymentIntents        PaymentIntent[]
  providers             ResourceProvider[]
  auditEvents           AuditEvent[]
  outboxEvents          OutboxEvent[]
  notificationEndpoints NotificationEndpoint[]
  retentionPolicy       DataRetentionPolicy?
  deletionRequests      DeletionRequest[]
  entitlement           OrganizationEntitlement?
  supportCases          SupportCase[]
  cardholders           CardholderProfile[]
  virtualCards          VirtualCard[]
  cardAuthorizations    CardAuthorization[]
  fiatAccounts          FiatAccount[]
  fiatTransfers         FiatTransfer[]
  resourceReviews       ResourceReview[]
  issuedInvoices        AgentInvoice[]              @relation("InvoiceIssuerOrganization")
  receivedInvoices      AgentInvoice[]              @relation("InvoiceRecipientOrganization")
  invoiceSequence       InvoiceSequence?
  crossChainQuotes      CrossChainRouteQuote[]
  crossChainTransfers   CrossChainTransfer[]
  contractAllowlist     ContractAllowlistEntry[]
  automationRules       AutomationRule[]
  automationExecutions  AutomationExecution[]
  financialObservations FinancialObservationDaily[]
  forecasts             SpendForecast[]
  financialAnomalies    FinancialAnomaly[]
  budgetRecommendations BudgetRecommendation[]
  intelligenceRuns      IntelligenceRun[]
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  roles          Role[]
  status         MembershipStatus @default(ACTIVE)
  invitedAt      DateTime         @default(now()) @db.Timestamptz
  activatedAt    DateTime?        @db.Timestamptz
  suspendedAt    DateTime?        @db.Timestamptz
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
}

model WalletIdentity {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  network        String
  accountId      String
  walletProvider String
  verifiedAt     DateTime @default(now()) @db.Timestamptz
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([network, accountId])
}

model WalletAuthChallenge {
  id         String    @id @db.Uuid
  accountId  String
  nonceHash  String
  expiresAt  DateTime  @db.Timestamptz
  consumedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  @@index([expiresAt, consumedAt])
}

model Agent {
  id                    String                      @id @default(uuid()) @db.Uuid
  organizationId        String                      @db.Uuid
  name                  String
  description           String?
  status                AgentStatus                 @default(PROVISIONING)
  network               String                      @default("hedera:testnet")
  defaultAssetId        String?                     @db.Uuid
  effectivePolicyId     String?                     @db.Uuid
  createdAt             DateTime                    @default(now()) @db.Timestamptz
  updatedAt             DateTime                    @updatedAt @db.Timestamptz
  organization          Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  defaultAsset          Asset?                      @relation(fields: [defaultAssetId], references: [id], onDelete: Restrict)
  effectivePolicy       PolicyVersion?              @relation("EffectivePolicy", fields: [effectivePolicyId], references: [id], onDelete: SetNull)
  accounts              PaymentAccount[]
  credentials           AgentCredential[]
  policies              Policy[]
  paymentIntents        PaymentIntent[]
  reservations          SpendReservation[]
  virtualCards          VirtualCard[]
  issuedInvoices        AgentInvoice[]              @relation("InvoiceIssuerAgent")
  receivedInvoices      AgentInvoice[]              @relation("InvoiceRecipientAgent")
  crossChainQuotes      CrossChainRouteQuote[]
  crossChainTransfers   CrossChainTransfer[]
  automationRules       AutomationRule[]
  financialObservations FinancialObservationDaily[]
  forecasts             SpendForecast[]
  financialAnomalies    FinancialAnomaly[]
  budgetRecommendations BudgetRecommendation[]

  @@index([organizationId, status])
}

model PaymentAccount {
  id                  String            @id @default(uuid()) @db.Uuid
  agentId             String            @db.Uuid
  network             String
  accountId           String
  evmAddress          String?
  publicKey           String?
  encryptedKeyBundle  String?
  custodyType         CustodyType
  signingMode         SigningMode
  status              AccountStatus     @default(PROVISIONING)
  delegationExpiresAt DateTime?         @db.Timestamptz
  syncedAt            DateTime?         @db.Timestamptz
  createdAt           DateTime          @default(now()) @db.Timestamptz
  updatedAt           DateTime          @updatedAt @db.Timestamptz
  agent               Agent             @relation(fields: [agentId], references: [id], onDelete: Restrict)
  balances            BalanceSnapshot[]

  @@index([network, accountId])
  @@index([agentId, status])
}

model Asset {
  id                    String                 @id @default(uuid()) @db.Uuid
  network               String
  type                  AssetType
  hederaTokenId         String?
  symbol                String
  name                  String
  decimals              Int
  verified              Boolean                @default(false)
  agents                Agent[]
  balances              BalanceSnapshot[]
  policies              PolicyVersion[]
  quotes                PaymentQuote[]
  reservations          SpendReservation[]
  prices                ResourcePrice[]
  settlements           Settlement[]
  invoices              AgentInvoice[]
  budgetRecommendations BudgetRecommendation[]

  @@unique([network, symbol])
  @@unique([network, hederaTokenId])
}

model BalanceSnapshot {
  id               String         @id @default(uuid()) @db.Uuid
  paymentAccountId String         @db.Uuid
  assetId          String         @db.Uuid
  atomicAmount     Decimal        @db.Decimal(78, 0)
  spendableAtomic  Decimal        @db.Decimal(78, 0)
  source           String
  asOf             DateTime       @db.Timestamptz
  paymentAccount   PaymentAccount @relation(fields: [paymentAccountId], references: [id], onDelete: Restrict)
  asset            Asset          @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([paymentAccountId, assetId, asOf(sort: Desc)])
}

model AgentCredential {
  id         String           @id @default(uuid()) @db.Uuid
  agentId    String           @db.Uuid
  label      String
  prefix     String           @unique
  secretHash String           @unique
  scopes     String[]
  status     CredentialStatus @default(ACTIVE)
  expiresAt  DateTime?        @db.Timestamptz
  lastUsedAt DateTime?        @db.Timestamptz
  revokedAt  DateTime?        @db.Timestamptz
  createdAt  DateTime         @default(now()) @db.Timestamptz
  agent      Agent            @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@index([agentId, status])
}

model Policy {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  agentId        String          @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  agent          Agent           @relation(fields: [agentId], references: [id], onDelete: Restrict)
  versions       PolicyVersion[]

  @@index([organizationId, agentId])
}

model PolicyVersion {
  id                        String           @id @default(uuid()) @db.Uuid
  policyId                  String           @db.Uuid
  version                   Int
  status                    PolicyStatus
  assetId                   String           @db.Uuid
  perTransactionLimitAtomic Decimal          @db.Decimal(78, 0)
  dailyLimitAtomic          Decimal          @db.Decimal(78, 0)
  overLimitAction           OverLimitAction
  merchantMode              MerchantMode     @default(ANY)
  allowedHosts              String[]
  deniedHosts               String[]
  approvalThreshold         Int              @default(1)
  rejectionThreshold        Int              @default(1)
  allowedMerchantCategories String[]
  activeFrom                DateTime?        @db.Timestamptz
  activeUntil               DateTime?        @db.Timestamptz
  allowedWeekdays           Int[]
  allowedStartMinute        Int?
  allowedEndMinute          Int?
  hourlyLimitAtomic         Decimal?         @db.Decimal(78, 0)
  monthlyLimitAtomic        Decimal?         @db.Decimal(78, 0)
  maxTransactionsPerHour    Int?
  cooldownSeconds           Int?
  createdBy                 String           @db.Uuid
  createdAt                 DateTime         @default(now()) @db.Timestamptz
  publishedAt               DateTime?        @db.Timestamptz
  policy                    Policy           @relation(fields: [policyId], references: [id], onDelete: Restrict)
  asset                     Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  activeForAgents           Agent[]          @relation("EffectivePolicy")
  decisions                 PolicyDecision[]

  @@unique([policyId, version])
  @@index([policyId, status])
}

model PaymentIntent {
  id                String               @id @default(uuid()) @db.Uuid
  organizationId    String               @db.Uuid
  agentId           String               @db.Uuid
  idempotencyKey    String
  requestHash       String
  resourceUrl       String
  merchantHost      String
  purpose           String?
  status            PaymentStatus        @default(CREATED)
  createdAt         DateTime             @default(now()) @db.Timestamptz
  updatedAt         DateTime             @updatedAt @db.Timestamptz
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  agent             Agent                @relation(fields: [agentId], references: [id], onDelete: Restrict)
  quote             PaymentQuote?
  decisions         PolicyDecision[]
  reservation       SpendReservation?
  approval          ApprovalRequest?
  attempts          PaymentAttempt[]
  fulfillment       ResourceFulfillment?
  invoiceSettlement InvoiceSettlement?
  resourceReview    ResourceReview?

  @@unique([organizationId, agentId, idempotencyKey])
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([agentId, createdAt(sort: Desc)])
}

model ResourceFulfillment {
  id              String            @id @default(uuid()) @db.Uuid
  paymentIntentId String            @unique @db.Uuid
  status          FulfillmentStatus @default(PENDING)
  contentType     String?
  contentHash     String?
  contentBytes    Int?
  responseBody    Json?
  errorCode       String?
  fulfilledAt     DateTime?         @db.Timestamptz
  createdAt       DateTime          @default(now()) @db.Timestamptz
  updatedAt       DateTime          @updatedAt @db.Timestamptz
  paymentIntent   PaymentIntent     @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
}

model PaymentQuote {
  id                  String        @id @default(uuid()) @db.Uuid
  paymentIntentId     String        @unique @db.Uuid
  x402Version         Int
  scheme              String
  network             String
  resourceDescription String?
  payToAccountId      String
  assetId             String        @db.Uuid
  amountAtomic        Decimal       @db.Decimal(78, 0)
  validUntil          DateTime      @db.Timestamptz
  fingerprint         String        @unique
  rawChallenge        Json?
  paymentIntent       PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  asset               Asset         @relation(fields: [assetId], references: [id], onDelete: Restrict)
}

model PolicyDecision {
  id                   String        @id @default(uuid()) @db.Uuid
  paymentIntentId      String        @db.Uuid
  policyVersionId      String        @db.Uuid
  outcome              PolicyOutcome
  reasonCodes          String[]
  factsHash            String
  spendBeforeAtomic    Decimal       @db.Decimal(78, 0)
  reservedBeforeAtomic Decimal       @db.Decimal(78, 0)
  projectedAtomic      Decimal       @db.Decimal(78, 0)
  evaluatedAt          DateTime      @default(now()) @db.Timestamptz
  paymentIntent        PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  policyVersion        PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@index([paymentIntentId, evaluatedAt(sort: Desc)])
}

model SpendReservation {
  id              String            @id @default(uuid()) @db.Uuid
  paymentIntentId String            @unique @db.Uuid
  agentId         String            @db.Uuid
  assetId         String            @db.Uuid
  amountAtomic    Decimal           @db.Decimal(78, 0)
  windowStart     DateTime          @db.Timestamptz
  windowEnd       DateTime          @db.Timestamptz
  status          ReservationStatus @default(ACTIVE)
  expiresAt       DateTime          @db.Timestamptz
  createdAt       DateTime          @default(now()) @db.Timestamptz
  updatedAt       DateTime          @updatedAt @db.Timestamptz
  paymentIntent   PaymentIntent     @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  agent           Agent             @relation(fields: [agentId], references: [id], onDelete: Restrict)
  asset           Asset             @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([agentId, assetId, windowStart, status])
}

model ApprovalRequest {
  id                 String             @id @default(uuid()) @db.Uuid
  paymentIntentId    String             @unique @db.Uuid
  status             ApprovalStatus     @default(PENDING)
  requestPurpose     String?
  requestedAt        DateTime           @default(now()) @db.Timestamptz
  expiresAt          DateTime           @db.Timestamptz
  decidedAt          DateTime?          @db.Timestamptz
  decidedBy          String?            @db.Uuid
  decisionNote       String?
  requiredApprovals  Int                @default(1)
  requiredRejections Int                @default(1)
  paymentIntent      PaymentIntent      @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  decisions          ApprovalDecision[]

  @@index([status, expiresAt])
}

model ApprovalDecision {
  id                String               @id @default(uuid()) @db.Uuid
  approvalRequestId String               @db.Uuid
  userId            String               @db.Uuid
  decision          ApprovalDecisionType
  note              String?
  createdAt         DateTime             @default(now()) @db.Timestamptz
  approvalRequest   ApprovalRequest      @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([approvalRequestId, userId])
  @@index([approvalRequestId, decision])
}

model PaymentAttempt {
  id                     String        @id @default(uuid()) @db.Uuid
  paymentIntentId        String        @db.Uuid
  attemptNumber          Int
  status                 AttemptStatus
  facilitatorRequestId   String?
  candidateTransactionId String?
  signatureFingerprint   String?
  errorCode              String?
  createdAt              DateTime      @default(now()) @db.Timestamptz
  updatedAt              DateTime      @updatedAt @db.Timestamptz
  paymentIntent          PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  settlement             Settlement?

  @@unique([paymentIntentId, attemptNumber])
  @@index([candidateTransactionId])
}

model Settlement {
  id                 String           @id @default(uuid()) @db.Uuid
  paymentAttemptId   String           @unique @db.Uuid
  assetId            String           @db.Uuid
  status             SettlementStatus
  network            String
  transactionId      String?
  consensusTimestamp String?
  payerAccountId     String
  payeeAccountId     String
  amountAtomic       Decimal          @db.Decimal(78, 0)
  resultCode         String?
  submittedAt        DateTime?        @db.Timestamptz
  confirmedAt        DateTime?        @db.Timestamptz
  paymentAttempt     PaymentAttempt   @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  asset              Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([network, transactionId])
  @@index([status, submittedAt])
}

model ResourceProvider {
  id                        String                     @id @default(uuid()) @db.Uuid
  organizationId            String?                    @db.Uuid
  name                      String
  publicSlug                String?                    @unique
  description               String?
  websiteUrl                String?
  supportEmail              String?
  termsUrl                  String?
  privacyUrl                String?
  status                    ProviderStatus             @default(ACTIVE)
  verificationStatus        ProviderVerificationStatus @default(UNVERIFIED)
  verifiedAt                DateTime?                  @db.Timestamptz
  settlementAccountId       String
  settlementAccountVerified Boolean                    @default(false)
  createdAt                 DateTime                   @default(now()) @db.Timestamptz
  organization              Organization?              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  resources                 ResourceListing[]
}

model ResourceListing {
  id                 String                @id @default(uuid()) @db.Uuid
  providerId         String                @db.Uuid
  category           ResourceCategory
  name               String
  slug               String                @unique
  description        String
  endpoint           String
  status             ResourceStatus        @default(DRAFT)
  inputSchema        Json
  outputContentTypes String[]
  version            Int                   @default(1)
  public             Boolean               @default(false)
  tags               String[]              @default([])
  termsUrl           String?
  serviceLevel       Json?
  healthStatus       ResourceHealthStatus  @default(UNKNOWN)
  lastHealthCheckAt  DateTime?             @db.Timestamptz
  createdAt          DateTime              @default(now()) @db.Timestamptz
  updatedAt          DateTime              @updatedAt @db.Timestamptz
  provider           ResourceProvider      @relation(fields: [providerId], references: [id], onDelete: Restrict)
  prices             ResourcePrice[]
  reviews            ResourceReview[]
  healthChecks       ResourceHealthCheck[]

  @@index([category, status])
}

model ResourcePrice {
  id                String          @id @default(uuid()) @db.Uuid
  resourceListingId String          @db.Uuid
  assetId           String          @db.Uuid
  atomicAmount      Decimal         @db.Decimal(78, 0)
  scheme            String          @default("exact")
  resourceListing   ResourceListing @relation(fields: [resourceListingId], references: [id], onDelete: Restrict)
  asset             Asset           @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([resourceListingId, assetId])
}

model ResourceReview {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  userId          String          @db.Uuid
  resourceId      String          @db.Uuid
  paymentIntentId String          @unique @db.Uuid
  rating          Int
  comment         String?
  status          ReviewStatus    @default(PUBLISHED)
  createdAt       DateTime        @default(now()) @db.Timestamptz
  updatedAt       DateTime        @updatedAt @db.Timestamptz
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  resource        ResourceListing @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  paymentIntent   PaymentIntent   @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)

  @@unique([userId, resourceId])
  @@index([resourceId, status, createdAt(sort: Desc)])
}

model ResourceHealthCheck {
  id         String               @id @default(uuid()) @db.Uuid
  resourceId String               @db.Uuid
  status     ResourceHealthStatus
  httpStatus Int?
  latencyMs  Int?
  errorCode  String?
  checkedAt  DateTime             @default(now()) @db.Timestamptz
  resource   ResourceListing      @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@index([resourceId, checkedAt(sort: Desc)])
}

model AgentInvoice {
  id                      String             @id @default(uuid()) @db.Uuid
  issuerOrganizationId    String             @db.Uuid
  recipientOrganizationId String             @db.Uuid
  issuerAgentId           String             @db.Uuid
  recipientAgentId        String             @db.Uuid
  assetId                 String             @db.Uuid
  number                  String
  status                  InvoiceStatus      @default(DRAFT)
  title                   String
  memo                    String?
  subtotalAtomic          Decimal            @db.Decimal(78, 0)
  totalAtomic             Decimal            @db.Decimal(78, 0)
  dueAt                   DateTime           @db.Timestamptz
  createdBy               String             @db.Uuid
  sentAt                  DateTime?          @db.Timestamptz
  viewedAt                DateTime?          @db.Timestamptz
  paidAt                  DateTime?          @db.Timestamptz
  voidedAt                DateTime?          @db.Timestamptz
  createdAt               DateTime           @default(now()) @db.Timestamptz
  updatedAt               DateTime           @updatedAt @db.Timestamptz
  issuerOrganization      Organization       @relation("InvoiceIssuerOrganization", fields: [issuerOrganizationId], references: [id], onDelete: Restrict)
  recipientOrganization   Organization       @relation("InvoiceRecipientOrganization", fields: [recipientOrganizationId], references: [id], onDelete: Restrict)
  issuerAgent             Agent              @relation("InvoiceIssuerAgent", fields: [issuerAgentId], references: [id], onDelete: Restrict)
  recipientAgent          Agent              @relation("InvoiceRecipientAgent", fields: [recipientAgentId], references: [id], onDelete: Restrict)
  asset                   Asset              @relation(fields: [assetId], references: [id], onDelete: Restrict)
  items                   InvoiceItem[]
  events                  InvoiceEvent[]
  settlement              InvoiceSettlement?

  @@unique([issuerOrganizationId, number])
  @@index([issuerOrganizationId, status, createdAt(sort: Desc)])
  @@index([recipientOrganizationId, status, dueAt])
}

model InvoiceSequence {
  organizationId String       @id @db.Uuid
  nextNumber     BigInt       @default(1)
  updatedAt      DateTime     @updatedAt @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model InvoiceItem {
  id               String       @id @default(uuid()) @db.Uuid
  invoiceId        String       @db.Uuid
  description      String
  quantity         Int
  unitAmountAtomic Decimal      @db.Decimal(78, 0)
  totalAtomic      Decimal      @db.Decimal(78, 0)
  position         Int
  invoice          AgentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, position])
}

model InvoiceEvent {
  id         String       @id @default(uuid()) @db.Uuid
  invoiceId  String       @db.Uuid
  actorType  String
  actorId    String?
  action     String
  metadata   Json
  occurredAt DateTime     @default(now()) @db.Timestamptz
  invoice    AgentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId, occurredAt])
}

model InvoiceSettlement {
  id              String        @id @default(uuid()) @db.Uuid
  invoiceId       String        @unique @db.Uuid
  paymentIntentId String        @unique @db.Uuid
  transactionId   String        @unique
  network         String
  settledAt       DateTime      @db.Timestamptz
  createdAt       DateTime      @default(now()) @db.Timestamptz
  invoice         AgentInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorType      String
  actorId        String?
  action         String
  targetType     String
  targetId       String?
  result         AuditResult
  requestId      String?
  metadata       Json
  occurredAt     DateTime     @default(now()) @db.Timestamptz
  chainSequence  BigInt       @default(dbgenerated())
  previousHash   String?
  eventHash      String       @unique @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([organizationId, action])
  @@index([organizationId, eventHash])
  @@unique([organizationId, chainSequence])
}

model OutboxEvent {
  id                String                   @id @default(uuid()) @db.Uuid
  organizationId    String                   @db.Uuid
  eventType         String
  aggregateType     String
  aggregateId       String
  payload           Json
  attempts          Int                      @default(0)
  availableAt       DateTime                 @default(now()) @db.Timestamptz
  processedAt       DateTime?                @db.Timestamptz
  claimedAt         DateTime?                @db.Timestamptz
  claimToken        String?                  @db.Uuid
  lastError         String?
  deadLetteredAt    DateTime?                @db.Timestamptz
  directChannel     NotificationChannelType?
  directDestination String?
  createdAt         DateTime                 @default(now()) @db.Timestamptz
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deliveries        NotificationDelivery[]

  @@index([processedAt, availableAt])
}

model NotificationEndpoint {
  id                     String                     @id @default(uuid()) @db.Uuid
  organizationId         String                     @db.Uuid
  type                   NotificationChannelType
  name                   String
  destination            String
  eventTypes             String[]
