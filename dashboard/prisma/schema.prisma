  id                    String                @id @default(uuid()) @db.Uuid
  organizationId        String                @db.Uuid
  fiatAccountId         String                @db.Uuid
  provider              CardProvider
  externalTransferId    String
  idempotencyKey        String
  requestHash           String
  direction             FiatTransferDirection
  status                FiatTransferStatus    @default(PENDING)
  amountMinor           Decimal               @db.Decimal(78, 0)
  currency              String                @db.VarChar(3)
  failureCode           String?
  instrumentIdEncrypted String?
  description           String?
  createdAt             DateTime              @default(now()) @db.Timestamptz
  updatedAt             DateTime              @updatedAt @db.Timestamptz
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fiatAccount           FiatAccount           @relation(fields: [fiatAccountId], references: [id], onDelete: Restrict)

  @@unique([provider, externalTransferId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([status, updatedAt])
}

model ProviderWebhookEvent {
  id              String                @id @default(uuid()) @db.Uuid
  provider        CardProvider
  externalEventId String
  eventType       String
  payloadHash     String
  status          ProviderWebhookStatus @default(RECEIVED)
  errorCode       String?
  receivedAt      DateTime              @default(now()) @db.Timestamptz
  processedAt     DateTime?             @db.Timestamptz

  @@unique([provider, externalEventId])
  @@index([provider, status, receivedAt])
}
