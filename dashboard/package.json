{
  "name": "agentpay-control",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Policy-controlled x402 payment OS for autonomous software agents across Hedera, Arc and Cardano",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daniel419797/agentpay-control.git"
  },
  "author": "Daniel <praisedaniel979@gmail.com>",
  "packageManager": "npm@11.11.1",
  "engines": {
    "node": "22.x",
    "npm": ">=10.9.7 <12"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "prebuild": "bash ../scripts/ci/verify-unified-topology.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:resources:check": "tsx scripts/canonicalize-resource-endpoints.ts",
    "db:resources:canonicalize": "tsx scripts/canonicalize-resource-endpoints.ts --apply",
    "verify:identity-isolation": "tsx scripts/verify-payment-identity-isolation.ts",
    "verify:governance": "tsx scripts/verify-governance.ts",
    "verify:mcp": "node --check packages/mcp/src/server.mjs",
    "db:studio": "prisma studio",
    "verify": "npm run lint && npm run typecheck && npm run verify:mcp && npm run test && npm run build"
  },
  "dependencies": {
    "@hashgraph/hedera-wallet-connect": "^2.1.3",
    "@hiero-ledger/proto": "^2.31.0",
    "@hiero-ledger/sdk": "2.86.2",
    "@hookform/resolvers": "5.2.2",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@reown/appkit": "^1.8.10",
    "@reown/appkit-adapter-ethers": "^1.8.23",
    "@reown/appkit-controllers": "^1.8.10",
    "@reown/walletkit": "^1.2.8",
    "@solana/kit": "^7.1.0",
    "@supabase/supabase-js": "^2.110.8",
    "@walletconnect/modal": "^2.7.0",
    "@x402/core": "2.20.0",
    "@x402/svm": "^2.20.0",
    "blakejs": "^1.2.1",
    "cbor": "^10.0.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ethers": "6.17.0",
    "jose": "6.1.3",
    "lucide-react": "0.468.0",
    "next": "16.3.0",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.71.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "undici": "7.29.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.0.10",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "jsdom": "28.1.0",
    "lightningcss": "1.31.1",
    "postcss": "8.5.25",
    "prisma": "7.9.1",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.9",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.1",
    "lightningcss": "^1.31.1",
    "lightningcss-linux-x64-gnu": "^1.31.1"
  },
  "overrides": {
    "typescript": "5.9.3"
  }
}
