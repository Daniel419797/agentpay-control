{
  "name": "agentpay-control",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Policy-controlled payment OS for autonomous software agents using x402 standard on Hedera testnet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daniel419797/agentpay-control.git"
  },
  "author": "Daniel <praisedaniel979@gmail.com>",
  "packageManager": "npm@11.11.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "verify:governance": "tsx scripts/verify-governance.ts",
    "db:studio": "prisma studio",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@hashgraph/hedera-wallet-connect": "^2.1.3",
    "@hiero-ledger/proto": "^2.31.0",
    "@hiero-ledger/sdk": "2.86.2",
    "@hookform/resolvers": "5.7.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@reown/appkit": "^1.8.10",
    "@reown/appkit-controllers": "^1.8.10",
    "@reown/walletkit": "^1.2.8",
    "@supabase/supabase-js": "^2.112.0",
    "@walletconnect/modal": "^2.7.0",
    "@x402/core": "2.21.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ethers": "6.17.0",
    "jose": "6.2.8",
    "lucide-react": "1.28.0",
    "next": "16.3.0",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "undici": "8.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.0.10",
    "@types/pg": "8.20.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "jsdom": "28.1.0",
    "lightningcss": "1.33.0",
    "postcss": "8.5.6",
    "prisma": "7.9.1",
    "tailwindcss": "4.2.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss": "^1.33.0",
    "lightningcss-linux-x64-gnu": "^1.31.1"
  },
  "overrides": {
    "typescript": "5.9.3"
  }
}
