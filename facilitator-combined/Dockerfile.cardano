FROM node:22-alpine AS workspace
WORKDIR /app
RUN npm install --global npm@11.11.1
COPY package.json package-lock.json ./
COPY dashboard/package.json ./dashboard/package.json
COPY facilitator/package.json ./facilitator/package.json
COPY facilitator-arc/package.json ./facilitator-arc/package.json
COPY facilitator-combined/package.json ./facilitator-combined/package.json
COPY resource-server/package.json ./resource-server/package.json

FROM workspace AS build
RUN --mount=type=cache,id=agentpay-cardano-mainnet-npm,target=/root/.npm,sharing=locked \
    npm ci --workspace=@agentpay/combined-facilitator --include-workspace-root=false \
    --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000
COPY facilitator ./facilitator
COPY facilitator-arc ./facilitator-arc
COPY facilitator-combined ./facilitator-combined
RUN npm run build --workspace=@agentpay/combined-facilitator
RUN npm prune --omit=dev --workspace=@agentpay/combined-facilitator --include-workspace-root=false

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/facilitator-combined/package.json ./facilitator-combined/package.json
COPY --from=build /app/facilitator-combined/dist ./facilitator-combined/dist
USER node
WORKDIR /app/facilitator-combined
EXPOSE 8789
CMD ["node", "dist/cardano-index.js"]
