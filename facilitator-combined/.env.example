APP_ENV=development
PORT=8787

# The public facilitator mounts exact network paths:
#   /hedera/testnet
#   /hedera/mainnet
#   /arc/testnet
#   /cardano/preprod
#   /cardano/mainnet
# Root /verify and /settle dispatch by the x402 requirement network.

# ------------------------- Hedera Testnet -------------------------
HEDERA_TESTNET_OPERATOR_ID=
HEDERA_TESTNET_OPERATOR_KEY=
HEDERA_TESTNET_OPERATOR_KEY_TYPE=
HEDERA_TESTNET_PAYER_ID=
HEDERA_TESTNET_PAYER_KEY=
HEDERA_TESTNET_PAYER_KEY_TYPE=
HEDERA_TESTNET_MANAGED_AGENT_MASTER_KEY=
HEDERA_TESTNET_MANAGED_AGENT_INITIAL_TINYBAR=0
HEDERA_TESTNET_MANAGED_SIGNING_API_KEY=
HEDERA_TESTNET_SETTLEMENT_API_KEY=
HEDERA_TESTNET_CONTRACT_EXECUTION_API_KEY=
HEDERA_TESTNET_CONTRACT_ALLOWLIST_JSON=[]

# -------------------------- Hedera Mainnet ------------------------
HEDERA_MAINNET_OPERATOR_ID=
HEDERA_MAINNET_OPERATOR_KEY=
HEDERA_MAINNET_OPERATOR_KEY_TYPE=
HEDERA_MAINNET_PAYER_ID=
HEDERA_MAINNET_PAYER_KEY=
HEDERA_MAINNET_PAYER_KEY_TYPE=
# No mainnet managed-agent master key. Mainnet agent custody is self-custody.
HEDERA_MAINNET_MANAGED_SIGNING_API_KEY=
HEDERA_MAINNET_SETTLEMENT_API_KEY=
HEDERA_MAINNET_CONTRACT_EXECUTION_API_KEY=
HEDERA_MAINNET_CONTRACT_ALLOWLIST_JSON=[]

# ---------------------------- Arc Testnet -------------------------
ARC_TESTNET_PAYER_PRIVATE_KEY=
ARC_TESTNET_RELAYER_PRIVATE_KEY=
ARC_TESTNET_CONTRACT_EXECUTION_PRIVATE_KEY=
ARC_TESTNET_MANAGED_AGENT_MASTER_KEY=
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_TESTNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_TESTNET_PROVIDER_ADDRESS=
ARC_TESTNET_MANAGED_SIGNING_API_KEY=
ARC_TESTNET_SETTLEMENT_API_KEY=
ARC_TESTNET_CONTRACT_EXECUTION_API_KEY=
ARC_TESTNET_CONTRACT_ALLOWLIST_JSON=[]

# Arc public mainnet is intentionally not configured until its public launch.

# ----------------------------- Cardano ----------------------------
# One signer service origin; network paths are appended internally.
CARDANO_SIGNER_ORIGIN=https://agentpay-cardano-signer.example.com
CARDANO_PREPROD_SIGNER_API_KEY=
CARDANO_MAINNET_SIGNER_API_KEY=

CARDANO_PREPROD_BLOCKFROST_URL=https://cardano-preprod.blockfrost.io/api/v0
CARDANO_PREPROD_BLOCKFROST_PROJECT_ID=
CARDANO_PREPROD_USDCX_ASSET_ID=31dde3db98ad05feb688d4dbb146b3b6054e1246cbcef98c79b0bf665553444378
CARDANO_PREPROD_MANAGED_SIGNING_API_KEY=
CARDANO_PREPROD_SETTLEMENT_API_KEY=

CARDANO_MAINNET_BLOCKFROST_URL=https://cardano-mainnet.blockfrost.io/api/v0
CARDANO_MAINNET_BLOCKFROST_PROJECT_ID=
CARDANO_MAINNET_USDCX_ASSET_ID=1f3aec8bfe7ea4fe14c5f121e2a92e301afe414147860d557cac7e345553444378
# Mainnet key is a transaction-preparation capability, not managed custody.
CARDANO_MAINNET_MANAGED_SIGNING_API_KEY=
CARDANO_MAINNET_SETTLEMENT_API_KEY=

# Full HTTPS Vercel endpoint, e.g.:
# https://agentpay-zeta.vercel.app/api/v1/internal/cardano-settlement-claims
CARDANO_SETTLEMENT_STORE_URL=
CARDANO_SETTLEMENT_STORE_API_KEY=

CARDANO_MAX_FEE_LOVELACE=1000000
CARDANO_CONFIRMATION_TIMEOUT_MS=120000
CARDANO_CONFIRMATION_POLL_MS=3000
