APP_ENV=development
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
# Required for a raw 64-hex operator key: ECDSA or ED25519.
HEDERA_OPERATOR_KEY_TYPE=
# Infrastructure contract/settlement payer. Never assigned as an agent wallet.
HEDERA_PAYER_ID=
HEDERA_PAYER_KEY=
# Required for a raw 64-hex payer key: ECDSA or ED25519.
HEDERA_PAYER_KEY_TYPE=
# TESTNET ONLY. Exactly 32 random bytes encoded as 43-char unpadded base64url.
# Every Hedera managed agent derives a distinct Ed25519 identity from agentId.
HEDERA_MANAGED_AGENT_MASTER_KEY=
HEDERA_MANAGED_AGENT_INITIAL_TINYBAR=0

# Arc chain service credentials. Production requires these infrastructure roles
# to be distinct. Managed agents do NOT use ARC_PAYER_PRIVATE_KEY; each gets a
# per-agent secp256k1 identity derived from ARC_MANAGED_AGENT_MASTER_KEY.
ARC_PAYER_PRIVATE_KEY=
ARC_RELAYER_PRIVATE_KEY=
ARC_CONTRACT_EXECUTION_PRIVATE_KEY=
# TESTNET ONLY. Exactly 32 random bytes encoded as 43-char unpadded base64url.
ARC_MANAGED_AGENT_MASTER_KEY=
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_PROVIDER_ADDRESS=

# Cardano exact x402 rail. One deployment is scoped to one network.
# The child verifier/settler is configured unsigned-only in the production
# Blueprint. Dedicated managed Preprod routes proxy to the separate Cardano
# signer, which derives a unique address/key per immutable agentId.
CARDANO_NETWORK=preprod
CARDANO_SIGNING_MODE=unsigned-only
CARDANO_USDCX_ASSET_ID=
CARDANO_BLOCKFROST_URL=https://cardano-preprod.blockfrost.io/api/v0
CARDANO_BLOCKFROST_PROJECT_ID=
CARDANO_SIGNER_URL=
CARDANO_SIGNER_API_KEY=
# Full HTTPS dashboard endpoint, for example:
# https://app.example.com/api/v1/internal/cardano-settlement-claims
CARDANO_SETTLEMENT_STORE_URL=
CARDANO_SETTLEMENT_STORE_API_KEY=
CARDANO_MAX_FEE_LOVELACE=1000000
CARDANO_CONFIRMATION_TIMEOUT_MS=90000
CARDANO_CONFIRMATION_POLL_MS=3000

# Network-scoped capability credentials. Production requires each populated
# capability/custody/store credential to be distinct.
HEDERA_MANAGED_SIGNING_API_KEY=
HEDERA_SETTLEMENT_API_KEY=
HEDERA_CONTRACT_EXECUTION_API_KEY=
ARC_MANAGED_SIGNING_API_KEY=
ARC_SETTLEMENT_API_KEY=
ARC_CONTRACT_EXECUTION_API_KEY=
CARDANO_MANAGED_SIGNING_API_KEY=
CARDANO_SETTLEMENT_API_KEY=

# Legacy generic capability keys are accepted only outside production.
MANAGED_SIGNING_API_KEY=
SETTLEMENT_API_KEY=
CONTRACT_EXECUTION_API_KEY=

HEDERA_BASE_PATH=/hedera
ARC_BASE_PATH=/arc
CARDANO_BASE_PATH=/cardano
CONTRACT_ALLOWLIST_JSON=[]
PORT=8787