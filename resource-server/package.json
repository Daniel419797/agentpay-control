{
  "name": "@agentpay/resource-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "preflight": "node dist/production-preflight.js",
    "start": "npm run preflight && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "hono": "4.12.32",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.23.7",
    "typescript": "7.0.2"
  }
}
