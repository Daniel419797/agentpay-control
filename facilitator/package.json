{
  "name": "@agentpay/hedera-facilitator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./app": { "types": "./dist/app.d.ts", "default": "./dist/app.js" }
  },
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "verify:live": "node --env-file=.env --import tsx scripts/live-x402.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "2.86.2",
    "@hono/node-server": "2.1.0",
    "@x402/core": "2.21.0",
    "@x402/hedera": "2.21.0",
    "hono": "4.13.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.0.10",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}