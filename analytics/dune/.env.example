# Dune write credential used only while publishing/updating queries/dashboard.
DUNE_API_KEY=

# Public Cardano deployment facts inserted into SQL templates.
DUNE_PROVIDER_ADDRESS=
DUNE_USDCX_ASSET_UNIT=1f3aec8bfe7ea4fe14c5f121e2a92e301afe414147860d557cac7e345553444378

# Leave IDs blank on the first publication. `publish.mjs` prints the created IDs;
# persist them in deployment configuration before subsequent updates.
DUNE_AGENTPAY_OVERVIEW_QUERY_ID=
DUNE_AGENTPAY_ACTIVITY_QUERY_ID=
DUNE_AGENTPAY_SAMPLE_QUERY_ID=

# `publish-dashboard.mjs` can create these on first run or reuse existing IDs.
DUNE_AGENTPAY_OVERVIEW_VIZ_ID=
DUNE_AGENTPAY_ACTIVITY_VIZ_ID=
DUNE_AGENTPAY_DASHBOARD_ID=
DUNE_DASHBOARD_NAME=AgentPay on Cardano
DUNE_OVERVIEW_VIZ_OPTIONS_JSON={}
DUNE_ACTIVITY_VIZ_OPTIONS_JSON={}
DUNE_CLI_BIN=dune

# After publication, configure the actual public URL in the dashboard runtime.
DUNE_DASHBOARD_URL=
