NODE_ENV=production
AGENTPAY_API_ORIGIN=https://agentpay.example.com
CARD_EXECUTOR_SHARED_SECRET=replace-with-a-distinct-random-secret-at-least-32-characters
STRIPE_ISSUING_RESTRICTED_KEY=rk_live_replace_me
# Optional. Omit to use the Stripe account's configured API version.
STRIPE_ISSUING_API_VERSION=
CARD_EXECUTOR_CONCURRENCY=1
CARD_EXECUTOR_POLL_INTERVAL_MS=1000
# Comma-separated exact HTTPS dependency hosts required by approved checkout pages.
# Empty is the safest default. Add hosts only after reviewing the merchant flow.
CARD_EXECUTOR_TRUSTED_EGRESS_HOSTS=
