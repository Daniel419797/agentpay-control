APP_ENV=development
NODE_ENV=development
PORT=8791

# One Render service serves both Cardano networks through:
#   /preprod/*
#   /mainnet/*
# The gateway starts isolated network-scoped signer workers internally.

CARDANO_PREPROD_BLOCKFROST_URL=https://cardano-preprod.blockfrost.io/api/v0
CARDANO_PREPROD_BLOCKFROST_PROJECT_ID=
CARDANO_PREPROD_SIGNER_API_KEY=
CARDANO_PREPROD_MANAGED_AGENT_MASTER_KEY=
CARDANO_PREPROD_USDCX_ASSET_ID=31dde3db98ad05feb688d4dbb146b3b6054e1246cbcef98c79b0bf665553444378

CARDANO_MAINNET_BLOCKFROST_URL=https://cardano-mainnet.blockfrost.io/api/v0
CARDANO_MAINNET_BLOCKFROST_PROJECT_ID=
CARDANO_MAINNET_SIGNER_API_KEY=
CARDANO_MAINNET_USDCX_ASSET_ID=1f3aec8bfe7ea4fe14c5f121e2a92e301afe414147860d557cac7e345553444378

# Optional for Mainnet autonomous managed agents. The adapter must resolve a
# distinct Ed25519 public key/signer reference per immutable Agent ID and sign
# only the supplied Cardano transaction-body hash. Keep this credential on the
# isolated signer only.
CARDANO_MAINNET_AGENT_CUSTODY_URL=
CARDANO_MAINNET_AGENT_CUSTODY_API_KEY=

# Mainnet deliberately has no CARDANO_MAINNET_MANAGED_AGENT_MASTER_KEY.
# Production rejects raw Cardano signing seeds.

CARDANO_MIN_OUTPUT_LOVELACE=1000000
CARDANO_TOKEN_OUTPUT_LOVELACE=2000000
CARDANO_MIN_CHANGE_LOVELACE=2000000
CARDANO_MAX_INPUTS=20
