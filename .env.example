# Application
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL (local Docker default)
DATABASE_URL=postgresql://agentpay:agentpay@localhost:54329/agentpay?schema=public

# Hedera testnet
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_PAYER_ACCOUNT_ID=
HEDERA_PROVIDER_ACCOUNT_ID=
HEDERA_USDC_TOKEN_ID=
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
FACILITATOR_URL=
FACILITATOR_FEE_PAYER_ID=
FACILITATOR_API_KEY=
KEY_ENCRYPTION_MASTER_KEY=
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=notifications@agentpay.dev
X402_NETWORK=hedera:testnet

# Virtual cards and fiat rails. Use SANDBOX only for local/test environments.
VIRTUAL_CARDS_ENABLED=false
CARD_PROVIDER=SANDBOX
STRIPE_RESTRICTED_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_MONEY_MANAGEMENT_VERSION=2026-02-25.preview

# Cross-chain routing (LI.FI API key is optional but recommended for production rate limits)
LIFI_API_BASE_URL=https://li.quest/v1
LIFI_API_KEY=
EVM_RPC_URLS_JSON={"eip155:11155111":"https://your-sepolia-rpc.example","eip155:84532":"https://your-base-sepolia-rpc.example"}

# Key encryption (MVP testnet envelope key, base64-encoded 32 bytes)
KEY_ENCRYPTION_MASTER_KEY=
CRON_SECRET=

# Optional external integrations
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
