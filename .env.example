# AgentPay dashboard/API (Vercel) + local defaults
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3100
AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://agentpay:agentpay@localhost:54329/agentpay?schema=public
RESOURCE_SERVER_URL=http://localhost:3200

# -----------------------------------------------------------------------------
# Unified facilitator topology
# -----------------------------------------------------------------------------
# Production Vercel should normally set only one public Render origin here.
# The dashboard derives:
#   /hedera/testnet
#   /hedera/mainnet
#   /arc/testnet
#   /cardano/preprod
#   /cardano/mainnet
AGENTPAY_FACILITATOR_ORIGIN=

# Legacy per-network URLs remain optional migration overrides. Leave empty once
# AGENTPAY_FACILITATOR_ORIGIN is active.
FACILITATOR_URL=
HEDERA_MAINNET_FACILITATOR_URL=
ARC_FACILITATOR_URL=
CARDANO_PREPROD_FACILITATOR_URL=
CARDANO_MAINNET_FACILITATOR_URL=

# IMPORTANT: managed-agent master keys and blockchain private keys are Render
# signer/facilitator secrets. Never place them in Vercel.

# -----------------------------------------------------------------------------
# Hedera dashboard/control-plane capabilities
# -----------------------------------------------------------------------------
HEDERA_NETWORK=testnet
# Infrastructure IDs used for payee/contract routing only; never agent wallets.
HEDERA_PAYER_ACCOUNT_ID=
HEDERA_PROVIDER_ACCOUNT_ID=
HEDERA_USDC_TOKEN_ID=
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Copy these values from the matching Render-generated capabilities:
# FACILITATOR_SIGNING_API_KEY       = HEDERA_TESTNET_MANAGED_SIGNING_API_KEY
# FACILITATOR_SETTLEMENT_API_KEY    = HEDERA_TESTNET_SETTLEMENT_API_KEY
# FACILITATOR_CONTRACT_API_KEY      = HEDERA_TESTNET_CONTRACT_EXECUTION_API_KEY
FACILITATOR_API_KEY=
FACILITATOR_SIGNING_API_KEY=
FACILITATOR_SETTLEMENT_API_KEY=
FACILITATOR_CONTRACT_API_KEY=

HEDERA_MAINNET_FACILITATOR_API_KEY=
# Mainnet managed-agent custody is disabled. This optional capability is not a
# user-wallet key and may be used only by bounded infrastructure paths.
HEDERA_MAINNET_FACILITATOR_SIGNING_API_KEY=
HEDERA_MAINNET_FACILITATOR_CONTRACT_API_KEY=
HEDERA_MAINNET_PAYER_ACCOUNT_ID=
HEDERA_MAINNET_MIRROR_NODE_URL=https://mainnet-public.mirrornode.hedera.com
HEDERA_MAINNET_PROVIDER_ACCOUNT_ID=
HEDERA_MAINNET_USDC_TOKEN_ID=

# -----------------------------------------------------------------------------
# Arc Testnet dashboard/control-plane capabilities
# -----------------------------------------------------------------------------
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_PROVIDER_ADDRESS=
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_FACILITATOR_API_KEY=
# Match Render ARC_TESTNET_* capabilities.
ARC_FACILITATOR_SIGNING_API_KEY=
ARC_FACILITATOR_SETTLEMENT_API_KEY=
ARC_FACILITATOR_CONTRACT_API_KEY=
# Legacy compatibility only; isolated managed agents never inherit it.
ARC_PAYER_ADDRESS=

# Arc public Mainnet is not configured until a public network is actually live
# and independently reviewed. Do not point Testnet credentials at a Mainnet URL.

# -----------------------------------------------------------------------------
# Cardano dashboard/control-plane configuration
# -----------------------------------------------------------------------------
CARDANO_SETTLEMENT_STORE_API_KEY=
CARDANO_USDCX_ENABLED=false
CARDANO_PREPROD_USDCX_ASSET_ID=31dde3db98ad05feb688d4dbb146b3b6054e1246cbcef98c79b0bf665553444378
CARDANO_MAINNET_USDCX_ASSET_ID=1f3aec8bfe7ea4fe14c5f121e2a92e301afe414147860d557cac7e345553444378

CARDANO_PREPROD_FACILITATOR_API_KEY=
# Match Render CARDANO_PREPROD_MANAGED_SIGNING_API_KEY / SETTLEMENT_API_KEY.
CARDANO_PREPROD_FACILITATOR_SIGNING_API_KEY=
CARDANO_PREPROD_FACILITATOR_SETTLEMENT_API_KEY=
# Legacy compatibility only; isolated managed agents receive unique addr_test1...
# identities and do not use this shared payer.
CARDANO_PREPROD_PAYER_ADDRESS=
CARDANO_PREPROD_PROVIDER_ADDRESS=
CARDANO_PREPROD_BLOCKFROST_URL=https://cardano-preprod.blockfrost.io/api/v0
CARDANO_PREPROD_BLOCKFROST_PROJECT_ID=

CARDANO_MAINNET_FACILITATOR_API_KEY=
# Match Render CARDANO_MAINNET_MANAGED_SIGNING_API_KEY (prepare capability only)
# and CARDANO_MAINNET_SETTLEMENT_API_KEY. Mainnet managed deterministic custody
# remains prohibited.
CARDANO_MAINNET_FACILITATOR_SIGNING_API_KEY=
CARDANO_MAINNET_FACILITATOR_SETTLEMENT_API_KEY=
CARDANO_MAINNET_PAYER_ADDRESS=
CARDANO_MAINNET_PROVIDER_ADDRESS=
CARDANO_MAINNET_BLOCKFROST_URL=https://cardano-mainnet.blockfrost.io/api/v0
CARDANO_MAINNET_BLOCKFROST_PROJECT_ID=

# -----------------------------------------------------------------------------
# Render-only signer/facilitator secrets (examples/documentation only)
# DO NOT copy any of the values below into Vercel production.
# -----------------------------------------------------------------------------
# HEDERA_TESTNET_OPERATOR_ID=
# HEDERA_TESTNET_OPERATOR_KEY=
# HEDERA_TESTNET_OPERATOR_KEY_TYPE=
# HEDERA_TESTNET_PAYER_ID=
# HEDERA_TESTNET_PAYER_KEY=
# HEDERA_TESTNET_PAYER_KEY_TYPE=
# HEDERA_TESTNET_MANAGED_AGENT_MASTER_KEY=
# HEDERA_MAINNET_OPERATOR_ID=
# HEDERA_MAINNET_OPERATOR_KEY=
# HEDERA_MAINNET_OPERATOR_KEY_TYPE=
# HEDERA_MAINNET_PAYER_ID=
# HEDERA_MAINNET_PAYER_KEY=
# HEDERA_MAINNET_PAYER_KEY_TYPE=
# ARC_TESTNET_PAYER_PRIVATE_KEY=
# ARC_TESTNET_RELAYER_PRIVATE_KEY=
# ARC_TESTNET_CONTRACT_EXECUTION_PRIVATE_KEY=
# ARC_TESTNET_MANAGED_AGENT_MASTER_KEY=
# CARDANO_PREPROD_MANAGED_AGENT_MASTER_KEY=
# CARDANO_PREPROD_SIGNER_API_KEY=
# CARDANO_MAINNET_SIGNER_API_KEY=

# -----------------------------------------------------------------------------
# Pyth Hermes policy valuation
# -----------------------------------------------------------------------------
PYTH_POLICY_ENABLED=false
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_API_KEY=
PYTH_ADA_USD_FEED_ID=
PYTH_USDC_USD_FEED_ID=
PYTH_REQUEST_TIMEOUT_MS=5000

# Masumi Registry identity/discovery trust.
MASUMI_POLICY_ENABLED=false
MASUMI_REGISTRY_URL=https://registry.masumi.network/api/v1
MASUMI_REGISTRY_API_KEY=
MASUMI_TRUSTED_REGISTRY_POLICY_IDS=
MASUMI_REQUEST_TIMEOUT_MS=7000

# Masumi escrow settlement is intentionally separate from direct x402.
MASUMI_ESCROW_ENABLED=false
MASUMI_PAYMENT_URL=
MASUMI_PAYMENT_API_KEY=
MASUMI_PAYMENT_TIMEOUT_MS=10000
MASUMI_PAYMENT_MAX_LOOKUP_PAGES=10

# Veridian/KERI/ACDC verification.
VERIDIAN_IDENTITY_ENABLED=false
VERIDIAN_KERIA_CREDENTIAL_VERIFY_URL=
VERIDIAN_KERIA_API_KEY=
VERIDIAN_KERIA_TIMEOUT_MS=10000
VERIDIAN_TRUSTED_ISSUER_AIDS=
VERIDIAN_ALLOWED_SCHEMA_SAIDS=

# Dune analytics is read-only and never authorizes payment.
DUNE_ANALYTICS_ENABLED=false
DUNE_API_URL=https://api.dune.com/api/v1
DUNE_API_KEY=
DUNE_AGENTPAY_OVERVIEW_QUERY_ID=
DUNE_AGENTPAY_ACTIVITY_QUERY_ID=
DUNE_AGENTPAY_SAMPLE_QUERY_ID=
DUNE_DASHBOARD_URL=
DUNE_REQUEST_TIMEOUT_MS=7000

# Enable only for the full Catalyst production profile.
CATALYST_PRODUCTION_ENABLED=false
RELEASE_SHA=
RELEASE_EVIDENCE_API_KEY=

RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=notifications@agentpay.dev
X402_NETWORK=hedera:testnet

# Virtual cards and fiat rails. Enable only after production provider approval.
VIRTUAL_CARDS_ENABLED=false
CARD_PROVIDER=SANDBOX
STRIPE_RESTRICTED_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_MONEY_MANAGEMENT_VERSION=2026-02-25.preview

# Cross-chain routing
LIFI_API_BASE_URL=https://li.quest/v1
LIFI_API_KEY=
EVM_RPC_URLS_JSON={"eip155:11155111":"https://your-sepolia-rpc.example","eip155:84532":"https://your-base-sepolia-rpc.example","eip155:5042002":"https://rpc.testnet.arc.network"}

# Dashboard-only data-encryption key. Independent from every signer master key.
KEY_ENCRYPTION_MASTER_KEY=
CRON_SECRET=

# Optional external integrations
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
